rules_version = '2';

// Reglas de seguridad de (des)Conectado (contracts/firestore-data.md).
// Denegación por defecto: cualquier ruta o acción no permitida de forma explícita queda cerrada.
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function autenticado() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    function ultimoMovimientoId(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid)).data.lastMovementId;
    }

    // Perfil de la persona. Lo crea ella una sola vez tras autenticarse; el saldo solo cambia junto
    // con un movimiento validado dentro de una transacción.
    match /users/{uid} {
      allow read: if esDueno(uid);

      allow create: if autenticado()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'email', 'createdAt', 'pointsBalance'])
        && request.resource.data.keys().hasAll(['username', 'email', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 1
        && request.resource.data.username.size() <= 30
        && request.resource.data.email is string
        && request.auth.token.email != null
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.createdAt == request.time
        // Nadie nace con puntos. Ausente equivale a 0 (el APK de la entrega 1 no escribe el campo).
        && request.resource.data.get('pointsBalance', 0) is int
        && request.resource.data.get('pointsBalance', 0) == 0;

      allow update: if esDueno(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pointsBalance', 'lastMovementId'])
        && request.resource.data.pointsBalance is int
        && request.resource.data.pointsBalance >= 0
        && request.resource.data.lastMovementId is string
        && !exists(/databases/$(database)/documents/users/$(uid)/movements/$(request.resource.data.lastMovementId))
        && existsAfter(/databases/$(database)/documents/users/$(uid)/movements/$(request.resource.data.lastMovementId))
        && getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(request.resource.data.lastMovementId)).data.amount is int
        && getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(request.resource.data.lastMovementId)).data.createdAt == request.time
        && (
          (getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(request.resource.data.lastMovementId)).data.type == 'credit'
            && request.resource.data.pointsBalance == resource.data.get('pointsBalance', 0)
              + getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(request.resource.data.lastMovementId)).data.amount)
          ||
          (getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(request.resource.data.lastMovementId)).data.type == 'redeem'
            && request.resource.data.pointsBalance == resource.data.get('pointsBalance', 0)
              - getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(request.resource.data.lastMovementId)).data.amount
            && (
              (existsAfter(/databases/$(database)/documents/users/$(uid)/redeemedRewards/$(getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(request.resource.data.lastMovementId)).data.sourceId))
                && getAfter(/databases/$(database)/documents/users/$(uid)/redeemedRewards/$(getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(request.resource.data.lastMovementId)).data.sourceId)).data.costPoints == getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(request.resource.data.lastMovementId)).data.amount)
              ||
              (exists(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current)
                && get(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.redemptionId == getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(request.resource.data.lastMovementId)).data.redemptionId
                && getAfter(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.pointsDebited == get(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.pointsDebited
                  + getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(request.resource.data.lastMovementId)).data.amount))
            )
          ||
          (getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(request.resource.data.lastMovementId)).data.type == 'expire'
            && request.resource.data.pointsBalance == resource.data.get('pointsBalance', 0)
              - getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(request.resource.data.lastMovementId)).data.amount)
        );

      allow delete: if false;
    }

    match /users/{uid}/activeChallenge/{challengeId} {
      allow read: if esDueno(uid);
      allow create: if esDueno(uid) && challengeId == 'current'
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.offlineSeconds == 0;
      allow update: if esDueno(uid) && challengeId == 'current';
      allow delete: if esDueno(uid) && challengeId == 'current';
    }

    match /users/{uid}/challengeResults/{runId} {
      allow read: if esDueno(uid);
      allow create: if esDueno(uid)
        && request.resource.data.challengeRunId == runId
        && request.resource.data.pointsAwarded >= 0
        && request.resource.data.measuredSocialSeconds >= 0
        && request.resource.data.offlineSeconds >= 0;
      allow update, delete: if false;
    }

    match /users/{uid}/challengeRatings/{runId} {
      allow read: if esDueno(uid);
      allow create: if esDueno(uid)
        && request.resource.data.keys().hasOnly(['challengeRunId', 'stars', 'createdAt'])
        && request.resource.data.challengeRunId == runId
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/users/$(uid)/challengeRatings/$(runId))
        && get(/databases/$(database)/documents/users/$(uid)/challengeResults/$(runId)).data.status == 'COMPLETED';
      allow update, delete: if false;
    }

    match /users/{uid}/pendingRedemptions/{pendingId} {
      allow read: if esDueno(uid);
      allow create: if esDueno(uid)
        && pendingId == 'current'
        && !exists(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current)
        && request.resource.data.keys().hasOnly(['redemptionId', 'rewardId', 'name', 'costPoints', 'code', 'pointsDebited', 'lotDebits', 'createdAt', 'updatedAt'])
        && request.resource.data.redemptionId is string
        && request.resource.data.rewardId is string
        && request.resource.data.name is string
        && request.resource.data.costPoints is int
        && request.resource.data.costPoints > 0
        && (request.resource.data.code == null
          || (request.resource.data.code is string && request.resource.data.code.size() > 3))
        && request.resource.data.pointsDebited == 0
        && request.resource.data.lotDebits is map
        && request.resource.data.lotDebits.keys().size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && get(/databases/$(database)/documents/rewards/$(request.resource.data.rewardId)).data.costPoints == request.resource.data.costPoints
        && get(/databases/$(database)/documents/users/$(uid)).data.pointsBalance >= request.resource.data.costPoints;
      allow update: if esDueno(uid)
        && pendingId == 'current'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pointsDebited', 'lotDebits', 'updatedAt'])
        && request.resource.data.redemptionId == resource.data.redemptionId
        && request.resource.data.rewardId == resource.data.rewardId
        && request.resource.data.costPoints == resource.data.costPoints
        && request.resource.data.pointsDebited is int
        && request.resource.data.pointsDebited > resource.data.pointsDebited
        && request.resource.data.pointsDebited <= resource.data.costPoints
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.type == 'redeem'
        && getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.redemptionId == resource.data.redemptionId
        && request.resource.data.pointsDebited == resource.data.pointsDebited
          + getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.amount
        && request.resource.data.lotDebits.diff(resource.data.lotDebits).affectedKeys()
          .hasOnly([getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.lotId])
        && !resource.data.lotDebits.keys().hasAny([getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.lotId])
        && request.resource.data.lotDebits[getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.lotId]
          == getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.amount;
      allow delete: if esDueno(uid)
        && pendingId == 'current'
        && resource.data.pointsDebited == resource.data.costPoints
        && existsAfter(/databases/$(database)/documents/users/$(uid)/redeemedRewards/$(resource.data.redemptionId))
        && getAfter(/databases/$(database)/documents/users/$(uid)/redeemedRewards/$(resource.data.redemptionId)).data.rewardId == resource.data.rewardId
        && getAfter(/databases/$(database)/documents/users/$(uid)/redeemedRewards/$(resource.data.redemptionId)).data.costPoints == resource.data.costPoints;
    }

    match /users/{uid}/pointLots/{lotId} {
      allow read: if esDueno(uid);
      allow create: if esDueno(uid)
        && !exists(/databases/$(database)/documents/users/$(uid)/pointLots/$(lotId))
        && request.resource.data.keys().hasOnly(['lotId', 'localDate', 'timeZoneId', 'windowStartsAt', 'windowEndsAt', 'earnedAt', 'expiresAt', 'issuedPoints', 'remainingPoints'])
        && request.resource.data.lotId == lotId
        && request.resource.data.issuedPoints is int
        && request.resource.data.remainingPoints == request.resource.data.issuedPoints
        && request.resource.data.issuedPoints > 0
        && request.resource.data.timeZoneId is string
        && request.resource.data.localDate is string
        && request.resource.data.windowStartsAt is timestamp
        && request.resource.data.windowEndsAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.earnedAt is timestamp
        && getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.type == 'credit'
        && getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.lotId == lotId
        && getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.amount == request.resource.data.issuedPoints;
      allow update: if esDueno(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['issuedPoints', 'remainingPoints', 'earnedAt'])
        && getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.lotId == lotId
        && (
          (getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.type == 'credit'
            && request.resource.data.issuedPoints == resource.data.issuedPoints
              + getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.amount
            && request.resource.data.remainingPoints == resource.data.remainingPoints
              + getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.amount
            && (request.resource.data.earnedAt == resource.data.earnedAt
              || request.resource.data.earnedAt == getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.earnedAt))
          ||
          (getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.type == 'expire'
            && request.time >= resource.data.expiresAt
            && !exists(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current)
            && getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.amount == resource.data.remainingPoints
            && request.resource.data.remainingPoints == 0
            && request.resource.data.issuedPoints == resource.data.issuedPoints)
          ||
          (getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.type == 'redeem'
            && getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.amount == resource.data.remainingPoints - request.resource.data.remainingPoints
            && get(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.createdAt < resource.data.expiresAt
            && request.resource.data.remainingPoints >= 0
            && request.resource.data.issuedPoints == resource.data.issuedPoints)
        );
      allow delete: if false;
    }

    match /users/{uid}/pointLotSessions/{sessionId} {
      allow read: if esDueno(uid);
      allow create, update: if esDueno(uid)
        && sessionId == 'current'
        && request.resource.data.keys().hasOnly(['lotId', 'windowEndsAt'])
        && request.resource.data.lotId is string
        && request.resource.data.windowEndsAt is timestamp
        && getAfter(/databases/$(database)/documents/users/$(uid)/pointLots/$(request.resource.data.lotId)).data.windowEndsAt == request.resource.data.windowEndsAt
        && getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.lotId == request.resource.data.lotId
        && getAfter(/databases/$(database)/documents/users/$(uid)/movements/$(ultimoMovimientoId(uid))).data.type == 'credit';
      allow delete: if false;
    }

    // Movimientos de puntos: solo los lee su dueña y se agregan dentro de una transacción.
    match /users/{uid}/movements/{movementId} {
      allow read: if esDueno(uid);
      allow create: if esDueno(uid)
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.sourceId is string
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.lastMovementId == movementId
        && (
          (request.resource.data.type == 'credit'
            && movementId == 'credit-' + request.resource.data.sourceId
            && request.resource.data.challengeId is string
            && request.resource.data.lotId is string
            && existsAfter(/databases/$(database)/documents/users/$(uid)/pointLots/$(request.resource.data.lotId))
            && getAfter(/databases/$(database)/documents/users/$(uid)/pointLots/$(request.resource.data.lotId)).data.remainingPoints >= request.resource.data.amount
            && getAfter(/databases/$(database)/documents/users/$(uid)/pointLotSessions/current).data.lotId == request.resource.data.lotId
            && getAfter(/databases/$(database)/documents/users/$(uid)/challengeResults/$(request.resource.data.sourceId)).data.status == 'COMPLETED'
            && request.time >= getAfter(/databases/$(database)/documents/users/$(uid)/challengeResults/$(request.resource.data.sourceId)).data.startedAt
              + duration.value(getAfter(/databases/$(database)/documents/users/$(uid)/challengeResults/$(request.resource.data.sourceId)).data.durationSeconds, 's')
            && get(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId)).data.points == request.resource.data.amount)
          ||
          (request.resource.data.type == 'redeem'
            && request.resource.data.rewardId is string
            && request.resource.data.get('challengeId', null) == null
            && request.resource.data.redemptionId is string
                && request.resource.data.lotId is string
                && movementId == 'redeem-' + request.resource.data.redemptionId + '-' + request.resource.data.lotId
                && request.resource.data.sourceId == request.resource.data.redemptionId
                && get(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.redemptionId == request.resource.data.redemptionId
                && get(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.rewardId == request.resource.data.rewardId
                && !get(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.lotDebits.keys().hasAny([request.resource.data.lotId])
                && request.resource.data.amount <= get(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.costPoints
                  - get(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.pointsDebited
                && get(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.createdAt
                  < get(/databases/$(database)/documents/users/$(uid)/pointLots/$(request.resource.data.lotId)).data.expiresAt
                && getAfter(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.pointsDebited == get(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.pointsDebited + request.resource.data.amount
                && getAfter(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.lotDebits.keys().size()
                  == get(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.lotDebits.keys().size() + 1
                && getAfter(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.lotDebits[request.resource.data.lotId] == request.resource.data.amount
                && get(/databases/$(database)/documents/users/$(uid)/pointLots/$(request.resource.data.lotId)).data.remainingPoints >= request.resource.data.amount
                && getAfter(/databases/$(database)/documents/users/$(uid)/pointLots/$(request.resource.data.lotId)).data.remainingPoints == get(/databases/$(database)/documents/users/$(uid)/pointLots/$(request.resource.data.lotId)).data.remainingPoints - request.resource.data.amount
                && request.resource.data.code == get(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.code
                && request.resource.data.createdAt == request.time)
          ||
          (request.resource.data.type == 'expire'
            && movementId == 'expire-' + request.resource.data.sourceId
            && request.resource.data.lotId == request.resource.data.sourceId
            && request.resource.data.get('challengeId', null) == null
            && !exists(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current)
            && get(/databases/$(database)/documents/users/$(uid)/pointLots/$(request.resource.data.lotId)).data.remainingPoints == request.resource.data.amount
            && request.time >= get(/databases/$(database)/documents/users/$(uid)/pointLots/$(request.resource.data.lotId)).data.expiresAt
            && getAfter(/databases/$(database)/documents/users/$(uid)/pointLots/$(request.resource.data.lotId)).data.remainingPoints == 0)
        );
      allow update, delete: if false;
      allow update, delete: if false;
    }

    match /users/{uid}/redeemedRewards/{redemptionId} {
      allow read: if esDueno(uid);
      allow create: if esDueno(uid)
        && request.resource.data.redemptionId == redemptionId
        && !exists(/databases/$(database)/documents/users/$(uid)/redeemedRewards/$(redemptionId))
        && request.resource.data.costPoints is int
        && request.resource.data.costPoints > 0
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current)
        && get(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.redemptionId == redemptionId
        && get(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.rewardId == request.resource.data.rewardId
        && get(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.costPoints == request.resource.data.costPoints
        && get(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.pointsDebited == request.resource.data.costPoints
        && get(/databases/$(database)/documents/users/$(uid)/pendingRedemptions/current).data.code == request.resource.data.code
        && request.resource.data.movementIds is list
        && request.resource.data.movementIds.size() > 0
        && (request.resource.data.code == null
          || (request.resource.data.code is string && request.resource.data.code.size() > 3));
      allow update, delete: if false;
    }

    // Catálogos provistos por la plataforma: los lee cualquier persona autenticada y nadie los
    // escribe desde la app (los carga el script de siembra con credenciales de administrador).
    match /challenges/{id} {
      allow read: if autenticado();
      allow write: if false;
    }

    match /rewards/{id} {
      allow read: if autenticado();
      allow write: if false;
    }

  }
}
